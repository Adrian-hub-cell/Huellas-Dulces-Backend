
{
  "info": {
    "name": "Huellas Dulces - Modulo 7",
    "description": "Coleccion de pruebas de autenticacion, productos, inventario y catalogo externo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{ADMIN_PASSWORD}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login exitoso', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuario\",\n  \"password\": \"{{USER_PASSWORD}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login USER exitoso', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Productos",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Crear producto ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Croquetas Postman\",\n  \"description\": \"Alimento para perros\",\n  \"category\": \"Alimento para perros\",\n  \"price\": 25000,\n  \"stock\": 10\n}"
            },
            "url": "{{baseUrl}}/api/v1/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Producto creado', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.id) pm.collectionVariables.set('productId', data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Consultar productos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products"
          }
        },
        {
          "name": "Consultar producto por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        },
        {
          "name": "Consultar categorias",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/categories"
          }
        },
        {
          "name": "Retirar inventario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}/withdraw"
          }
        },
        {
          "name": "Intentar crear producto como USER (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Producto no autorizado\",\n  \"description\": \"Prueba de seguridad\",\n  \"category\": \"Prueba\",\n  \"price\": 10000,\n  \"stock\": 5\n}"
            },
            "url": "{{baseUrl}}/api/v1/products"
          }
        }
      ]
    },
    {
      "name": "Catalogo externo",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Buscar producto externo",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/external-catalog/search?name=croquetas"
          }
        }
      ]
    }
  ]
}
